  "cards": [
    {
      "dot": "rose",
      "title": "信頼境界",
      "items": [
        "クライアント: ユーザー端末の Flutter 内は Secure Storage 以外は素のメモリ。",
        "サーバー: Render 上の Go + PostgreSQL は独立した信頼ゾーン。",
        "境界横断: BLE 空間の peer 端末と、url_launcher で開く外部 URL は未信頼扱い。"
      ]
    },
    {
      "dot": "emerald",
      "title": "エフェメラルトークンによるプライバシー",
      "items": [
        "BLE で発信するのは実 user_id ではなく SP_{token}（5 分ローテーション）。",
        "GET /users/:id/ephemeral-token でトークン取得、サーバー側で token → user_id を解決。",
        "検知確定時のみ POST /encounters に target_token を送出して記録。"
      ]
    },
    {
      "dot": "cyan",
      "title": "BLE ライフサイクル & オフライン保持",
      "items": [
        "MainScreen が WidgetsBindingObserver で resumed/detached を検知し BLE を開始/停止。",
        "未確認すれ違いは Secure Storage に JSON 保持、再起動後も突合可能。",
        "Render 無料枠のスリープ対策として SplashScreen が起動時にウォームアップ通信。"
      ]
    },
    {
      "dot": "violet",
      "title": "補助的な経路（エッジ非表示）",
      "items": [
        "Android のみ: MainScreen が MethodChannel `syshack/battery_optimization` でネイティブへ問い合わせ。",
        "プロフィール外部リンクは url_launcher で X / GitHub / connpass を外部ブラウザに委譲。",
        "flutter_blue_plus（スキャン）と flutter_ble_peripheral（アドバタイズ）は並走で動作。"
      ]
    }
  ]
